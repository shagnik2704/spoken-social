SECRET_KEY=spoken-social-dev-secret-key-change-me-later
DATABASE_URL=postgresql://YOUR_USERNAME@localhost/spoken_social

POSTGRES_DB=spoken_social
POSTGRES_USER=spoken_user
POSTGRES_PASSWORD=your_secure_password_here

# Forum integration: must match spoken-tutorial-forum/.env SPOKEN_SOCIAL_WEBHOOK_SECRET (or FORUM_WEBHOOK_SECRET there).
