SECRET_KEY=spoken-social-dev-secret-key-change-me-later
DATABASE_URL=postgresql://YOUR_USERNAME@localhost/spoken_social

POSTGRES_DB=spoken_social
POSTGRES_USER=spoken_user
POSTGRES_PASSWORD=your_secure_password_here

# Forum integration: must match spoken-tutorial-forum/.env SPOKEN_SOCIAL_WEBHOOK_SECRET (or FORUM_WEBHOOK_SECRET there).
# Verified on incoming POST /api/webhooks/forum via X-Webhook-Secret header.
FORUM_WEBHOOK_SECRET=generate_a_long_random_string_and_match_in_spoken_tutorial_forum

# ============================================================
# SWAYAM Plus Direct OIDC & M2M Partner Integration
# ============================================================
# Base URL of SWAYAM Plus (defaults to production if omitted)
SWAYAM_BASE_URL=https://swayamplus.education.gov.in

# OIDC Relying Party credentials (for student login & SSO)
# Obtained from SWAYAM Partner Dashboard (https://swayamplus.education.gov.in/login)
SWAYAM_OIDC_CLIENT_ID=your_swayam_oidc_client_id_here
SWAYAM_OIDC_CLIENT_SECRET=your_swayam_oidc_client_secret_here

# Redirect URI registered in SWAYAM Partner Dashboard
# e.g., https://social.edupyramids.org/api/auth/swayam/callback
#   or  https://beta.social.edupyramids.org/api/auth/swayam/callback
SWAYAM_REDIRECT_URI=https://beta.social.edupyramids.org/api/auth/swayam/callback

# M2M Credentials (for automated progress sync & completion confirmation)
# If identical to OIDC client, these can be omitted and will default to OIDC credentials.
SWAYAM_M2M_CLIENT_ID=your_swayam_m2m_client_id_here
SWAYAM_M2M_CLIENT_SECRET=your_swayam_m2m_client_secret_here